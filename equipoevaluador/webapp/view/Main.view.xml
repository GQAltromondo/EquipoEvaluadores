<mvc:View controllerName="transener.equipoevaluador.controller.Main"
    xmlns:mvc="sap.ui.core.mvc" displayBlock="true" xmlns:f="sap.ui.layout.form" xmlns:l="sap.ui.layout" xmlns:core="sap.ui.core"
    xmlns="sap.m">
    <Page id="page">
       <content>
					<HBox alignItems="Center" direction="Row" width="auto" height="auto" class="sapUiMediumMargin ContentHeader" renderType="Div"
						displayInline="false">
						<items>
							<HBox alignItems="Start" width="65%" class="ContentTitle" justifyContent="Start">
								<items>
									<Title text="{i18n>textLicHab}" titleStyle="H3" class="titleBlue" textAlign="Begin" visible="true"/>
									<Title text="{i18n>SeleccionEvaluador}" titleStyle="H4" class="subTitleBlue"/>
								</items>
								<layoutData/>
							</HBox>
							<VBox alignItems="Center" direction="Column" class="sapUiHideOnPhone ContentImg" fitContainer="false" width="35%" height="auto"
								justifyContent="End" renderType="Div" visible="true" displayInline="false">
								<items>
									<Image src="/html5apps/equipoevaluador/img/{/society}.png" height="auto" width="200px" densityAware="false"/>
								</items>
								<layoutData/>
							</VBox>
						</items>
						<layoutData/>
					</HBox>
					<f:Form editable="true" class="sapUiSmallMargin">
						<f:layout>
							<f:ResponsiveGridLayout labelSpanXL="8" labelSpanL="8" labelSpanM="8" labelSpanS="12" adjustLabelSpan="false" emptySpanXL="0" emptySpanL="0"
								emptySpanM="0" emptySpanS="0" columnsXL="1" columnsL="1" columnsM="1" singleContainerFullSize="false"/>
						</f:layout>
						<f:formContainers>
							<f:FormContainer>
								<f:formElements>
									<f:FormElement label="{i18n>Puser}">
										<f:fields>
											<Input showValueHelp="true" valueHelpOnly="true" value="{FiltrosModel>/Puser}" valueHelpRequest="onDialogEvaluador"/>
										</f:fields>
									</f:FormElement>
									<f:FormElement label="{i18n>NombreApellido}">
										<f:fields>
											<Input value="{FiltrosModel>/Nombre}" enabled="false"/>
										</f:fields>
									</f:FormElement>
								</f:formElements>
							</f:FormContainer>
						</f:formContainers>
					</f:Form>
					<VBox class="sapUiMediumMargin">
						<items>
							<List id="list" mode="Delete" delete="onPressDeleteEvaluador" enableBusyIndicator="true" headerText="Equipo Evaluador"
								items="{path: 'EvaluadoresModel>/EvaluadoresModel'}" growing="true">
								<CustomListItem>
									<HBox class="sapUiSmallMargin" alignItems="Center">
										<core:Icon size="50px" color="#0d63bf" src="sap-icon://customer" class="sapUiSmallMarginEnd"/>
										<VBox class="sapUiSmallMarginBegin" width="100%">
											<HBox >
												<Label text=" {i18n>Puser}: "/>
												<Text class="sapUiTinyMarginBegin" text="{EvaluadoresModel>Legajo}"/>
											</HBox>
											<HBox >
												<Label text="{i18n>NombreApellido}: "/>
												<Text class="sapUiTinyMarginBegin" text="{EvaluadoresModel>Nombre}"/>
											</HBox>
										</VBox>
										<Button 
											icon="{= ${EvaluadoresModel>Favorito} ? 'sap-icon://favorite' : 'sap-icon://unfavorite'}"
											type="{= ${EvaluadoresModel>Favorito} ? 'Transparent' : 'Transparent'}"
											press="onToggleFavorito"
											tooltip="{= ${EvaluadoresModel>Favorito} ? 'Quitar de favoritos' : 'Marcar como favorito'}"
											class="sapUiSmallMarginBegin"/>
									</HBox>
								</CustomListItem>
							</List>
						</items>
					</VBox>
				</content>
				<footer>
					<Bar>
						<contentRight>
							<Button icon="sap-icon://save" type="Emphasized" press="onSaveEvaluador" text="Guardar"/>
						</contentRight>
					</Bar>
				</footer>
    </Page>
</mvc:View>
