<core:FragmentDefinition xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Dialog
        id="evaluadoresDialog"
        title="Evaluadores"
        stretch="true"
        busy="{Evaluadores>/Busy}"
        busyIndicatorDelay="0"
        afterClose=".onAfterCloseEvaluadoresDialog">

        <subHeader>
            <OverflowToolbar>
                <SearchField
                    id="searchEvaluadores"
                    width="100%"
                    liveChange=".onSearchEvaluadores"
                    search=".onSearchEvaluadores"
                    placeholder="Buscar por Legajo, Nombre o Apellido"/>
            </OverflowToolbar>
        </subHeader>

        <content>
            <List
                id="idList"
                items="{Evaluadores>/Evaluadores}"
                mode="MultiSelect"
                includeItemInSelection="true"
                selectionChange=".onSelectionChangeEvaluadores"
                growing="true"
                growingThreshold="50">

                <infoToolbar>
                    <OverflowToolbar visible="{= ${Evaluadores>/SeleccionesGuardadas}.length > 0 }" id="idInfoToolbar">
                        <Label id="idFilterLabel"
                               text="{= ${Evaluadores>/SeleccionesGuardadas}.length + ' seleccionados' }"/>
                    </OverflowToolbar>
                </infoToolbar>

                <StandardListItem
                    title="{= ${Evaluadores>Nombre} + ' ' + ${Evaluadores>Apellido} }"
                    description="{Evaluadores>Correo}"
                    info="{Evaluadores>Legajo}"
                    type="Active"/>
            </List>
        </content>

        <beginButton>
            <Button text="Cancelar" press=".onCancelEvaluadoresDialog"/>
        </beginButton>

        <endButton>
            <Button text="Aceptar" type="Emphasized" press=".onAcceptEvaluadoresDialog"/>
        </endButton>

    </Dialog>
</core:FragmentDefinition>
